#include <stdio.h>
struct emp {
    int id;
    char name[20];
};
int main() {
    struct emp e;
    FILE *f=fopen("emp.dat","wb+");
    int n,i,k;
    printf("Enter number of employees: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) {
        scanf("%d%19s",&e.id,e.name);
        fwrite(&e,sizeof(e),1,f);
    }
    printf("Enter record number: ");
    scanf("%d",&k);
    fseek(f,(k-1)*sizeof(e),SEEK_SET);
    if(k>=1 && k<=n && fread(&e,sizeof(e),1,f)==1)
        printf("%d %s",e.id,e.name);
    else printf("Invalid record");
    fclose(f);
    return 0;
}

