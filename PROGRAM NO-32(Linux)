--#!/bin/bash

echo "===================================="
echo "       USER MANAGEMENT"
echo "===================================="

echo ""
echo "1. Current Username"
whoami

echo ""
echo "2. User ID and Group ID"
id

echo ""
echo "3. Currently Logged-in Users"
who

echo ""
echo "4. All System Users"
cut -d: -f1 /etc/passwd

echo ""
echo "5. Current User Groups"
groups

echo ""
echo "6. Home Directory"
echo "$HOME"

echo ""
echo "7. User Account Information"
getent passwd "$(whoami)"

echo ""
echo "===================================="
echo "    USER INFORMATION COMPLETED"
echo "===================================="
4.chmod +x user_management.sh
5../user_management.sh
6../user_management.sh
7.ls
