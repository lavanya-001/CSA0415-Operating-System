mkdir -p ~/OS-Lab/Experiment-26
cd ~/OS-Lab/Experiment-26

cat > multilevel_queue.c <<'EOF'
#include <stdio.h>

int main() {
    int n, i, time = 0;
    int bt[20], queue[20], ct[20], tat[20], wt[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter burst time for P%d: ", i + 1);
        scanf("%d", &bt[i]);

        printf("Enter queue (0 = High Priority, 1 = Low Priority): ");
        scanf("%d", &queue[i]);
    }

    printf("\nProcess\tQueue\tBT\tCT\tTAT\tWT\n");

    // Execute high-priority queue first
    for (int q = 0; q <= 1; q++) {
        for (i = 0; i < n; i++) {
            if (queue[i] == q) {
                time += bt[i];
                ct[i] = time;
                tat[i] = ct[i];
                wt[i] = tat[i] - bt[i];

                printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
                       i + 1, queue[i], bt[i],
                       ct[i], tat[i], wt[i]);
            }
        }
    }

    return 0;
}
EOF

gcc multilevel_queue.c -o multilevel_queue
./multilevel_queue
ls -l
