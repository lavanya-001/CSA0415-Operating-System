#include <stdio.h>
int main() {
    char f[5][5][20];
    int u,n[5],i,j;
    printf("Enter number of users: ");
    scanf("%d",&u);
    for(i=0;i<u;i++) {
        printf("Number of files for user %d: ",i+1);
        scanf("%d",&n[i]);
        for(j=0;j<n[i];j++) {
            printf("Enter filename: ");
            scanf("%19s",f[i][j]);
        }
    }
    for(i=0;i<u;i++) {
        printf("User %d:\n",i+1);
        for(j=0;j<n[i];j++) printf("%s\n",f[i][j]);
    }
    return 0;
}
