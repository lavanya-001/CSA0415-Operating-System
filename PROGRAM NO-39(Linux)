mkdir -p ~/OS-Lab/Experiment-19
cd ~/OS-Lab/Experiment-19

cat > process_types.c <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        return 1;
    }

    if (pid == 0) {
        printf("Child process: PID = %d\n", getpid());
        printf("Child is running...\n");
        sleep(2);
        printf("Child process completed.\n");
        exit(0);
    } else {
        printf("Parent process: PID = %d\n", getpid());
        printf("Parent is waiting for child...\n");
        wait(NULL);
        printf("Child process collected. No zombie remains.\n");
    }

    return 0;
}
EOF

gcc process_types.c -o process_types
./process_types
ls -l
