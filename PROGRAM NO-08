#include <stdio.h>
int main() {
    int n,i,q,b[10],r[10],t=0,x;
    printf("Enter number of processes: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) {
        scanf("%d",&b[i]); r[i]=b[i];
    }
    printf("Enter time quantum: ");
    scanf("%d",&q);
    do {
        x=0;
        for(i=0;i<n;i++)
            if(r[i]>0) {
                if(r[i]>q) {t+=q;r[i]-=q;}
                else {t+=r[i];r[i]=0;}
                x=1;
            }
    } while(x);
    printf("Total execution time = %d",t);
    return 0;
}

