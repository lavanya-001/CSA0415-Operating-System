#include <stdio.h>
int main() {
    int a,n,i,need[10];
    printf("Enter available resources: ");
    scanf("%d",&a);
    printf("Enter number of processes: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) {
        printf("Enter resources needed by process %d: ",i);
        scanf("%d",&need[i]);
    }
    for(i=0;i<n;i++)
        if(need[i]<=a) {
            a+=0;
            printf("P%d can finish\n",i);
        } else printf("P%d must wait\n",i);
    return 0;
}

