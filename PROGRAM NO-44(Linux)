mkdir -p ~/OS-Lab/Experiment-24
cd ~/OS-Lab/Experiment-24

cat > preemptive_priority.c <<'EOF'
#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int at[20], bt[20], rt[20], pr[20];
    int ct[20], tat[20], wt[20], response[20];
    int first[20], pos, highest;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter arrival time, burst time and priority for P%d: ", i + 1);
        scanf("%d %d %d", &at[i], &bt[i], &pr[i]);
        rt[i] = bt[i];
        first[i] = -1;
    }

    while (completed < n) {
        pos = -1;
        highest = 9999;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0 && pr[i] < highest) {
                highest = pr[i];
                pos = i;
            }
        }

        if (pos == -1) {
            time++;
            continue;
        }

        if (first[pos] == -1) {
            first[pos] = time;
            response[pos] = time - at[pos];
        }

        rt[pos]--;
        time++;

        if (rt[pos] == 0) {
            completed++;
            ct[pos] = time;
            tat[pos] = ct[pos] - at[pos];
            wt[pos] = tat[pos] - bt[pos];
        }
    }

    printf("\nProcess\tAT\tBT\tPriority\tCT\tTAT\tWT\tRT\n");

    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], pr[i],
               ct[i], tat[i], wt[i], response[i]);
    }

    return 0;
}
EOF

gcc preemptive_priority.c -o preemptive_priority
./preemptive_priority
ls -l
