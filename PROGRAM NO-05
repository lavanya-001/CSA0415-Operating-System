#include <stdio.h>
int main() {
    int n,i,j,p[10],pr[10],t;
    printf("Enter number of processes: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) {
        printf("Enter burst time and priority: ");
        scanf("%d%d",&p[i],&pr[i]);
    }
    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(pr[i]>pr[j]) {
                t=pr[i];pr[i]=pr[j];pr[j]=t;
                t=p[i];p[i]=p[j];p[j]=t;
            }
    printf("Burst times in execution order: ");
    for(i=0;i<n;i++) printf("%d ",p[i]);
    return 0;
}

