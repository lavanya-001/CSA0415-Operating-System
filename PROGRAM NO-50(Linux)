mkdir -p ~/OS-Lab/Experiment-30
cd ~/OS-Lab/Experiment-30

cat > named_pipe.c <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <string.h>
#include <sys/wait.h>

int main() {
    char *fifo = "/tmp/myfifo";
    char message[] = "Hello through Named Pipe";
    char buffer[100];

    mkfifo(fifo, 0666);

    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        return 1;
    }

    if (pid == 0) {
        int fd = open(fifo, O_RDONLY);
        read(fd, buffer, sizeof(buffer));
        printf("Child received: %s\n", buffer);
        close(fd);
    } else {
        int fd = open(fifo, O_WRONLY);
        write(fd, message, strlen(message) + 1);
        printf("Parent sent: %s\n", message);
        close(fd);
        wait(NULL);
    }

    unlink(fifo);
    return 0;
}
EOF

gcc named_pipe.c -o named_pipe
./named_pipe
ls -l
