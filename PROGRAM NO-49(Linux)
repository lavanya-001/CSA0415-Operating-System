mkdir -p ~/OS-Lab/Experiment-29
cd ~/OS-Lab/Experiment-29

cat > unnamed_pipe.c <<'EOF'
#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>

int main() {
    int fd[2];
    char message[] = "Hello from Parent Process";
    char buffer[100];

    if (pipe(fd) == -1) {
        perror("Pipe failed");
        return 1;
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        return 1;
    }

    if (pid == 0) {
        close(fd[1]);

        read(fd[0], buffer, sizeof(buffer));
        printf("Child received: %s\n", buffer);

        close(fd[0]);
    } else {
        close(fd[0]);

        write(fd[1], message, strlen(message) + 1);
        printf("Parent sent: %s\n", message);

        close(fd[1]);
        wait(NULL);
    }

    return 0;
}
EOF

gcc unnamed_pipe.c -o unnamed_pipe
./unnamed_pipe
ls -l
