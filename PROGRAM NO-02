#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int a, b, n;
    char buf[100];

    a = open("in.txt", O_RDONLY);
    b = open("out.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    while ((n = read(a, buf, sizeof(buf))) > 0)
        write(b, buf, n);

    close(a);
    close(b);

    printf("File copied successfully");
    return 0;
}

