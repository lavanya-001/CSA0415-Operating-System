mkdir -p ~/OS-Lab/Experiment-20
cd ~/OS-Lab/Experiment-20

cat > fcfs.c <<'EOF'
#include <stdio.h>

int main() {
    int n, i, j, time = 0;
    int p[20], at[20], bt[20], ct[20], tat[20], wt[20], rt[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("Enter arrival time and burst time for P%d: ", p[i]);
        scanf("%d %d", &at[i], &bt[i]);
    }

    // Sort processes by arrival time
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (at[i] > at[j]) {
                int temp;
                temp = at[i]; at[i] = at[j]; at[j] = temp;
                temp = bt[i]; bt[i] = bt[j]; bt[j] = temp;
                temp = p[i]; p[i] = p[j]; p[j] = temp;
            }
        }
    }

    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT\tRT\n");

    for (i = 0; i < n; i++) {
        if (time < at[i])
            time = at[i];

        rt[i] = time - at[i];
        time += bt[i];
        ct[i] = time;
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];

        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               p[i], at[i], bt[i], ct[i], tat[i], wt[i], rt[i]);
    }

    return 0;
}
EOF

gcc fcfs.c -o fcfs
./fcfs
ls -l
